            "metricName": "cnpg_pg_stat_archiver_seconds_since_last_archival",
            "metricType": "gauge"
          }
        ],
        "where": "ServiceName = 'notes-postgres'",
        "whereLanguage": "sql",
        "granularity": "auto",
        "numberFormat": {
          "output": "number",
          "mantissa": 1,
