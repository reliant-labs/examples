    {
      "id": "t-last-backup",
      "x": 0,
      "y": 49,
      "w": 24,
      "h": 7,
      "config": {
        "name": "Last backup",
        "source": "Metrics",
        "displayType": "line",
        "select": [
          {
            "aggFn": "max",
            "valueExpression": "",
            "alias": "plugin",
            "metricName": "barman_cloud_cloudnative_pg_io_last_available_backup_timestamp",
            "metricType": "gauge"
          },
          {
            "aggFn": "max",
            "valueExpression": "",
            "alias": "instance",
            "metricName": "cnpg_collector_last_available_backup_timestamp",
            "metricType": "gauge"
          }
        ],
        "where": "ServiceName = 'notes-postgres'",
        "whereLanguage": "sql",
        "granularity": "auto",
        "numberFormat": {
          "output": "number",
          "mantissa": 1,
          "thousandSeparated": true,
          "unit": "s"
        }
