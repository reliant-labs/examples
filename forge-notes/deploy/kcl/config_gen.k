# forge:section env-map appConfigEnvMap
# forge:hash=6ad2612e4fc4a12edbf75875a5e3fbd3466aab551624a81c366055c941dad635
# Every ENV_VAR AppConfig declares `sensitive: true` for. Used by forge's
# host-mode config probe, which resolves the whole config for `forge env up`
# and the parity report. A WORKLOAD must not use it: naming every
# credential is the broadcast that put one feature's secretKeyRef on
# every pod. Declare what a workload reads in its `config_secrets` instead.
APP_CONFIG_SENSITIVE_ENV: [str] = [
    # forge:section APP_CONFIG_SENSITIVE_ENV (root)
    # forge:hash=6c0144f3ee264f5bbe07ece38b109671c80e87ec6abc40548637bbe37a619ef1
    "DATABASE_URL"
    "JWT_SECRET"
    "IDP_BROKER_TOKEN"
    "IDP_LOGIN_POLICY"
    "JWT_JWKS_SNAPSHOT"

    # forge:section APP_CONFIG_SENSITIVE_ENV (end)
    # forge:hash=934bafb952ec2c52cebba90282eb5507e10de9bffd7f8fc3655f011d4787467c
]

# Every ENV_VAR AppConfig declares BOTH `sensitive: true` and
# `optional: true` for. The secret pre-flight skips these: a declared
# secret with no value is an error by default, and this is the author
# stating that THIS one's absence is intended (a tier's off-switch, a
# credential only some environments own).
APP_CONFIG_OPTIONAL_SECRET_ENV: [str] = [
    # forge:section APP_CONFIG_OPTIONAL_SECRET_ENV (end)
    # forge:hash=e935e0a7d63d662d53c4b76254053f7c57331af6433d7c9c5f58d4d5fc05a12d
]

# appConfigEnvMap projects a typed AppConfig into a workload's env MAP (fw.Workload.env):
# one entry per field that declares an env_var, keyed by ENV_VAR name — a
# string for an ordinary field, a forge.SecretRef for a sensitive one.
#
# Non-sensitive fields are projected for EVERY caller: they are inline
# values, so they carry no credential and no start-time dependency.
# Sensitive fields are projected ONLY when `config_secrets` NAMES them, so a
# workload's manifest carries the secretKeyRefs it declared and no others.
# A pod whose secretKeyRef names a missing key does not start — it stalls
# in CreateContainerConfigError with no application log — so a credential
# broadcast to workloads that never read it turns one feature's missing
# secret into a whole namespace outage.
#
#     env = appConfigEnvMap(cfg, config_secrets) | {EXTRA = "value"}
appConfigEnvMap = lambda c: AppConfig, config_secrets: [str] -> {str: str | forge.SecretRef} {
    _sensitive: {str: forge.SecretRef} = {
        # forge:section appConfigEnvMap secrets (root)
        # forge:hash=b3f6ddb66985f956029d28d1bb58b192b8c5588f980f4fc8a10e76f969cfa1e1
        "DATABASE_URL" = forge.SecretRef {name = c.database_url.name, key = c.database_url.key, store_key = "DATABASE_URL"}
        "JWT_SECRET" = forge.SecretRef {name = c.jwt_secret.name, key = c.jwt_secret.key, store_key = "JWT_SECRET"}
        "IDP_BROKER_TOKEN" = forge.SecretRef {name = c.idp_broker_token.name, key = c.idp_broker_token.key, store_key = "IDP_BROKER_TOKEN"}
        "IDP_LOGIN_POLICY" = forge.SecretRef {name = c.idp_login_policy.name, key = c.idp_login_policy.key, store_key = "IDP_LOGIN_POLICY"}
        "JWT_JWKS_SNAPSHOT" = forge.SecretRef {name = c.jwt_jwks_snapshot.name, key = c.jwt_jwks_snapshot.key, store_key = "JWT_JWKS_SNAPSHOT"}

        # forge:section appConfigEnvMap secrets (end)
        # forge:hash=bdce5d36c52f5c4e778cacd6a067c40f008546b0b9c4f98a89a1e5c0b30f6328
    }
    assert all _n in config_secrets { _n in _sensitive }, \
        "appConfigEnvMap: config_secrets names ${[_n for _n in config_secrets if _n not in _sensitive]}, which is not a `sensitive` field of AppConfig. Sensitive fields: ${sorted([_k for _k in _sensitive])}. Add `sensitive: true` to the field's (forge.v1.config) annotation in its config proto, or drop the name from this workload's config_secrets."
    {
        # forge:section appConfigEnvMap values (root)
        # forge:hash=1e2cdfaaa080f39e0814b8b9f629fcd4856b0a623f1f0923e540f68858eaab71
        "PORT" = str(c.port)
        "LOG_LEVEL" = c.log_level
        "CORS_ORIGINS" = c.cors_origins
        "CORS_ALLOW_CREDENTIALS" = "true" if c.cors_allow_credentials else "false"
        "CORS_ALLOW_HEADERS" = c.cors_allow_headers
        "CORS_EXPOSE_HEADERS" = c.cors_expose_headers
        "TLS_CERT_PATH" = c.tls_cert_path
        "TLS_KEY_PATH" = c.tls_key_path
        "PRE_STOP_DELAY" = c.pre_stop_delay
        "SHUTDOWN_TIMEOUT" = c.shutdown_timeout
        "LOG_FORMAT" = c.log_format
        "LOG_SUCCESS_SAMPLE_WINDOW" = c.log_success_sample_window
        "AUTO_MIGRATE" = "true" if c.auto_migrate else "false"
        "ENVIRONMENT" = c.environment
        "RATE_LIMIT_RPS" = str(c.rate_limit_rps)
        "RATE_LIMIT_BURST" = str(c.rate_limit_burst)
        "DB_MAX_OPEN_CONNS" = str(c.db_max_open_conns)
        "DB_MAX_IDLE_CONNS" = str(c.db_max_idle_conns)
        "DB_CONN_MAX_IDLE_TIME" = c.db_conn_max_idle_time
        "DB_CONN_MAX_LIFETIME" = c.db_conn_max_lifetime
        "DB_CONNECT_TIMEOUT" = c.db_connect_timeout
        "PPROF_ADDR" = c.pprof_addr
        "SECURITY_HEADERS_ENABLED" = "true" if c.security_headers_enabled else "false"
        "LIVENESS_PATHS" = c.liveness_paths
        "READINESS_PATHS" = c.readiness_paths
        "OTEL_EXPORTER_OTLP_ENDPOINT" = c.otlp_endpoint
        "READ_MAX_BYTES" = str(c.read_max_bytes)
        "SEND_MAX_BYTES" = str(c.send_max_bytes)
        "JWT_SIGNING_METHOD" = c.jwt_signing_method
        "JWT_ISSUER" = c.jwt_issuer
        "JWT_AUDIENCE" = c.jwt_audience
        "JWT_JWKS_URL" = c.jwt_jwks_url
        "OIDC_CLIENT_ID" = c.oidc_client_id
        "OIDC_REDIRECT_URI" = c.oidc_redirect_uri
        "OIDC_SCOPES" = c.oidc_scopes
        "IDP_LOGIN_URI" = c.idp_login_uri
        "IDP_BASE" = c.idp_base
        "IDP_HOST" = c.idp_host
        "IDP_BROKER_TOKEN_FILE" = c.idp_broker_token_file
        "TRUSTED_PROXY_HOPS" = str(c.trusted_proxy_hops)
        "AUTH_SELF_SIGNUP" = "true" if c.auth_self_signup else "false"
        "HANDOFF_REDIRECTS" = c.handoff_redirects
        "JWT_ROLES_CLAIM" = c.jwt_roles_claim
        "JWT_JWKS_SNAPSHOT_FILE" = c.jwt_jwks_snapshot_file
        "JWT_JWKS_SNAPSHOT_MAX_AGE" = c.jwt_jwks_snapshot_max_age

        # forge:section appConfigEnvMap values (end)
        # forge:hash=920eea05ab5dce3f310287b25e37276c4ed1d6c5622122261a0168a9c29e836f
    } | {_k: _sensitive[_k] for _k in _sensitive if _k in config_secrets}
}

# ---------------------------------------------------------------------------
# ROOTS — one per root of the composition graph (the //forge:root structs in
# internal/app, or the default `server`): the args that run it and the config
# it REACHES, read off its closure by forge generate. Bind a workload to one:
#
#     api = fw.Workload {
#         name = "api"
#         build = forge.GoBuild {cmd = "./cmd/<bin>", output_name = "<bin>"}
#     } | config_gen.root_of("server")
#
# and project its env with `config_gen.workloadEnvMap(cfg, w)`: exactly the
# values its root reaches and, of the credentials, those it reaches and
# requires, plus any `config_secrets` opts into (each must be reached).
# ---------------------------------------------------------------------------
schema Root:
    """One root of the composition graph, as a process."""
    args: [str]
    env: [str] = []
    secrets: [str] = []
    required_secrets: [str] = []

ROOTS: {str: Root} = {
    "server" = Root {
        args = ["server"]
        env = ["PORT", "LOG_LEVEL", "CORS_ORIGINS", "CORS_ALLOW_CREDENTIALS", "CORS_ALLOW_HEADERS", "CORS_EXPOSE_HEADERS", "TLS_CERT_PATH", "TLS_KEY_PATH", "PRE_STOP_DELAY", "SHUTDOWN_TIMEOUT", "LOG_FORMAT", "LOG_SUCCESS_SAMPLE_WINDOW", "AUTO_MIGRATE", "ENVIRONMENT", "RATE_LIMIT_RPS", "RATE_LIMIT_BURST", "DB_MAX_OPEN_CONNS", "DB_MAX_IDLE_CONNS", "DB_CONN_MAX_IDLE_TIME", "DB_CONN_MAX_LIFETIME", "DB_CONNECT_TIMEOUT", "PPROF_ADDR", "SECURITY_HEADERS_ENABLED", "LIVENESS_PATHS", "READINESS_PATHS", "OTEL_EXPORTER_OTLP_ENDPOINT", "READ_MAX_BYTES", "SEND_MAX_BYTES", "JWT_SIGNING_METHOD", "JWT_ISSUER", "JWT_AUDIENCE", "JWT_JWKS_URL", "OIDC_CLIENT_ID", "OIDC_REDIRECT_URI", "OIDC_SCOPES", "IDP_LOGIN_URI", "IDP_BASE", "IDP_HOST", "IDP_BROKER_TOKEN_FILE", "TRUSTED_PROXY_HOPS", "AUTH_SELF_SIGNUP", "HANDOFF_REDIRECTS", "JWT_ROLES_CLAIM", "JWT_JWKS_SNAPSHOT_FILE", "JWT_JWKS_SNAPSHOT_MAX_AGE"]
        secrets = ["DATABASE_URL", "JWT_SECRET", "IDP_BROKER_TOKEN", "IDP_LOGIN_POLICY", "JWT_JWKS_SNAPSHOT"]
        required_secrets = ["DATABASE_URL"]
    }
}

# root_of is what a workload merges in to run a root: its name and the args
# that run it. An unknown root fails the render.
root_of = lambda name: str -> {str:} {
    assert name in ROOTS, "root_of: no root named \"${name}\" — the roots are ${sorted([_k for _k in ROOTS])} (//forge:root structs in internal/app; forge generate refreshes this list)"
    {root = name, args = ROOTS[name].args}
}

# rootEnvMap is the config env of a workload bound to a root (w.root).
rootEnvMap = lambda c: AppConfig, w: any -> {str: str | forge.SecretRef} {
    assert w.root in ROOTS, "workload '${w.name}': root \"${w.root}\" is not a root of this binary — the roots are ${sorted([_k for _k in ROOTS])}"
    _r = ROOTS[w.root]
    assert not w.args or w.args == _r.args, "workload '${w.name}': args ${w.args} do not run root \"${w.root}\", which runs as ${_r.args} — bind it with config_gen.root_of(\"${w.root}\")"
    _opted = w.config_secrets or []
    assert all _n in _opted { _n in _r.secrets }, \
        "workload '${w.name}': config_secrets names ${[_n for _n in _opted if _n not in _r.secrets]}, which root \"${w.root}\" does not reach (it reaches ${_r.secrets}): a credential reaches only the workloads whose root reads it"
    _all = appConfigEnvMap(c, _r.required_secrets + [_n for _n in _opted if _n not in _r.required_secrets])
    {_k: _v for _k, _v in _all if _k in _r.env or _k in _r.secrets}
}

# workloadEnvMap is a workload's config env: rootEnvMap for a workload bound
# to a root, appConfigEnvMap (its config_secrets) for any other.
#
# The caller layers the workload's own env over it (`| w.env`), so a name
# the workload sets wins. A plain value is left out here rather than merged:
# KCL's union refuses a string under a reference, and that is exactly
# `forge.bucket_env("UPLOADS", "uploads")` over a typed config block whose
# unset leaves project as "" (`conflicting values on the attribute
# 'UPLOADS_ENDPOINT'`). A string the workload overrides with a string is
# replaced either way.
workloadEnvMap = lambda c: AppConfig, w: any -> {str: str | forge.SecretRef} {
    _all = rootEnvMap(c, w) if w.root else appConfigEnvMap(c, w.config_secrets or [])
    _own = w.env or {}
    {_k: _v for _k, _v in _all if _k not in _own or typeof(_v) != "str"}
}
